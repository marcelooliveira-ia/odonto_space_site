---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../config/site';
import { dentistSchema, breadcrumbSchema } from '../utils/schema';

interface Props {
  title: string;
  description: string;
  /** Caminho da página, ex.: "/implantes-dentarios" ("/" para a home). */
  path: string;
  /** Mensagem de WhatsApp contextual desta página (botão flutuante). */
  whatsappMessage?: string;
  /** Trilha de navegação para dados estruturados (páginas internas). */
  breadcrumb?: string;
  /** Emite o schema Dentist completo (home e contato). */
  includeBusinessSchema?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  whatsappMessage,
  breadcrumb,
  includeBusinessSchema = false,
  noindex = false,
} = Astro.props;

const siteUrl = (Astro.site ?? new URL('https://odonto-space-site.vercel.app')).origin;
const canonical = `${siteUrl}${path === '/' ? '' : path}`;
const ogImage = SITE.ogImagePath ? `${siteUrl}${SITE.ogImagePath}` : null;

const schemas: object[] = [];
if (includeBusinessSchema) schemas.push(dentistSchema(siteUrl));
if (breadcrumb) {
  schemas.push(
    breadcrumbSchema(siteUrl, [
      { name: 'Início', path: '/' },
      { name: breadcrumb, path },
    ]),
  );
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b2540" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header currentPath={path} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp message={whatsappMessage} />
  </body>
</html>
