---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada | ODONTO SPACE" description="A página que você procura não foi encontrada." path="/404" noindex>
  <section class="section">
    <div class="container" style="text-align:center;max-width:640px">
      <p class="eyebrow">Erro 404</p>
      <h1>Página não encontrada</h1>
      <p class="lead">O endereço pode ter mudado ou não existe mais.</p>
      <div class="btn-row" style="justify-content:center"><a class="btn btn--primary" href="/">Voltar ao início</a></div>
    </div>
  </section>
</BaseLayout>
