---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import { SERVICES } from '../config/site';
import { href } from '../utils/url';
import { genOrtoMaos, genInvisalign } from '../assets';

const msg = SERVICES.find((s) => s.slug === 'ortodontia-invisalign')!.whatsappMessage;
const faqs = [
  { q: 'Qual a diferença entre aparelho ortodôntico e Invisalign?', a: 'O aparelho ortodôntico é fixado nos dentes e ajustado pelo dentista. O Invisalign usa alinhadores transparentes removíveis, trocados em sequência. A melhor opção depende do seu caso.' },
  { q: 'O Invisalign serve para todos os casos?', a: 'Nem todos. A indicação depende da complexidade do alinhamento e das características de cada paciente, e é definida após a avaliação.' },
  { q: 'Adultos podem usar aparelho?', a: 'Sim. A avaliação define se o tratamento ortodôntico é indicado e qual a melhor abordagem em cada idade.' },
  { q: 'Quanto tempo dura o tratamento?', a: 'O tempo varia conforme o caso e a colaboração do paciente. O dentista apresenta uma estimativa no planejamento.' },
];
---
<BaseLayout title="Ortodontia e Invisalign em Bangu | ODONTO SPACE" description="Ortodontia e Invisalign em Bangu, Rio de Janeiro: avaliação para alinhar os dentes com aparelho ou alinhadores. Agende pelo WhatsApp." path="/ortodontia-invisalign" breadcrumb="Ortodontia e Invisalign" whatsappMessage={msg}>
  <section class="or-open">
    <Photo bg src={genInvisalign} alt="Alinhadores transparentes em um estojo branco sobre mármore" pos="60% 55%" eager widths={[800, 1200, 1600, 2000]} sizes="100vw" />
    <span class="bgcap">Fig. 01 · Imagem ilustrativa</span>
    <div class="wrap">
      <nav class="crumb label fx-in" aria-label="Você está em"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">Ortodontia e Invisalign</span></nav>
      <h1 class="or-title"><span class="ln"><span>Ortodontia</span></span><span class="ln"><span><em>e Invisalign</em></span></span></h1>
      <p class="lead fx-in">Alinhe seus dentes com a abordagem indicada para o seu caso: aparelho ortodôntico ou alinhadores Invisalign. Em Bangu.</p>
      <div class="row fx-in"><WhatsAppButton message={msg} context="ortodontia-hero" label="Agendar avaliação ortodôntica" /></div>
    </div>
  </section>

  <section class="or-two">
    <div class="wrap">
      <div class="or-two__head"><p class="label rv">Uma especialidade, duas abordagens</p><h2 class="rv d1">Na avaliação, a ortodontista analisa o seu caso e explica qual opção faz mais sentido.</h2></div>
      <div class="g12">
        <div class="or-two__a rv"><p class="or-word">Ortodontia</p><p class="d">Tratamento que corrige o alinhamento dos dentes e a forma como eles se encaixam, contribuindo para a função e a estética do sorriso. É acompanhado por consultas periódicas para ajustes.</p></div>
        <div class="or-two__b rv d2"><p class="or-word or-word--b">Invisalign</p><p class="d">Sistema de alinhadores transparentes e removíveis, trocados em sequência para mover os dentes gradualmente. A indicação depende da avaliação do seu caso.</p></div>
      </div>
    </div>
  </section>

  <section class="or-step on-mist" style="padding-top:clamp(4rem,8vw,7rem)">
    <div class="wrap">
      <Photo class="rv" src={genOrtoMaos} alt="Mãos enluvadas encaixando um alinhador transparente em um modelo dentário" ratio="16 / 8" pos="50% 42%" n="02" widths={[800, 1200, 1600, 2000]} sizes="100vw" />
      <div class="g12 or-step__body">
        <div class="or-step__h"><p class="label rv">Primeiro passo</p><h2 class="rv d1">Uma avaliação para planejar o seu tratamento.</h2></div>
        <div class="or-step__l rv d1">
          <ul><li>Análise do alinhamento e da mordida</li><li>Apresentação das opções adequadas ao seu caso</li><li>Esclarecimento de dúvidas sobre etapas e acompanhamento</li></ul>
          <WhatsAppButton message={msg} context="ortodontia-meio" variant="solid" />
        </div>
      </div>
    </div>
  </section>

  <section class="or-faq">
    <div class="wrap g12"><div class="or-faq__in">
      <p class="label rv">Dúvidas frequentes</p>
      <h2 class="rv d1">Perguntas sobre ortodontia.</h2>
      {faqs.map((f, i) => <div class="or-q rv"><span class="label">Pergunta {i + 1}</span><h3>{f.q}</h3><p>{f.a}</p></div>)}
      <p class="small" style="color:var(--mute);margin-top:1.4rem">Conteúdo informativo. Somente um cirurgião-dentista pode indicar o tratamento adequado após avaliar você. Invisalign é marca de seu respectivo titular.</p>
    </div></div>
  </section>
</BaseLayout>
