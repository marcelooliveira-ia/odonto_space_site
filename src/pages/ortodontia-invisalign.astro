---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../config/site';

const msg = SERVICES.find((s) => s.slug === 'ortodontia-invisalign')!.whatsappMessage;
const faqs = [
  { q: 'Qual a diferença entre aparelho ortodôntico e Invisalign?', a: 'O aparelho ortodôntico é fixado nos dentes e ajustado pelo dentista. O Invisalign usa alinhadores transparentes removíveis, trocados em sequência. A melhor opção depende do seu caso.' },
  { q: 'O Invisalign serve para todos os casos?', a: 'Nem todos. A indicação depende da complexidade do alinhamento e das características de cada paciente, e é definida após a avaliação.' },
  { q: 'Adultos podem usar aparelho?', a: 'Sim. A avaliação define se o tratamento ortodôntico é indicado e qual a melhor abordagem em cada idade.' },
  { q: 'Quanto tempo dura o tratamento?', a: 'O tempo varia conforme o caso e a colaboração do paciente. O dentista apresenta uma estimativa no planejamento.' },
];
---

<BaseLayout
  title="Ortodontia e Invisalign em Bangu | ODONTO SPACE"
  description="Ortodontia e Invisalign em Bangu, Rio de Janeiro: avaliação para alinhar os dentes com aparelho ou alinhadores. Agende pelo WhatsApp."
  path="/ortodontia-invisalign"
  breadcrumb="Ortodontia e Invisalign"
  whatsappMessage={msg}
>
  <PageHero
    eyebrow="Ortodontia e Invisalign"
    title="Ortodontia e Invisalign em Bangu"
    lead="Alinhe seus dentes com a abordagem indicada para o seu caso: aparelho ortodôntico ou alinhadores Invisalign."
  >
    <div class="btn-row"><WhatsAppButton message={msg} context="ortodontia-hero" size="lg" label="Agendar avaliação ortodôntica" /></div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Duas abordagens</p>
        <h2>Encontre o caminho ideal para o seu sorriso</h2>
        <p class="lead">Na avaliação, o dentista analisa o seu caso e explica qual opção faz mais sentido.</p>
      </div>
      <div class="grid grid--2">
        <div class="card">
          <span class="card__icon"><Icon name="tooth" size={24} /></span>
          <h3>Ortodontia</h3>
          <p>
            Tratamento que corrige o alinhamento dos dentes e a forma como eles se encaixam,
            contribuindo para a função e a estética do sorriso. É acompanhado por consultas periódicas
            para ajustes.
          </p>
        </div>
        <div class="card">
          <span class="card__icon"><Icon name="tooth" size={24} /></span>
          <h3>Invisalign</h3>
          <p>
            Sistema de alinhadores transparentes e removíveis, trocados em sequência para mover os dentes
            gradualmente. A indicação depende da avaliação do seu caso.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div>
        <p class="eyebrow">Primeiro passo</p>
        <h2>Uma avaliação para planejar o seu tratamento</h2>
        <ul class="checklist">
          <li><Icon name="check" size={20} /><span>Análise do alinhamento e da mordida</span></li>
          <li><Icon name="check" size={20} /><span>Apresentação das opções adequadas ao seu caso</span></li>
          <li><Icon name="check" size={20} /><span>Esclarecimento de dúvidas sobre etapas e acompanhamento</span></li>
        </ul>
        <div class="btn-row"><WhatsAppButton message={msg} context="ortodontia-meio" /></div>
      </div>
      <PhotoPlaceholder slot="ortodontia-1" ratio="4/3" caption="Foto real do atendimento ou consultório" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Dúvidas frequentes</p>
        <h2>Perguntas sobre ortodontia e Invisalign</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
      <p class="notice" style="margin-top:2rem">
        Conteúdo informativo. Somente um cirurgião-dentista pode indicar o tratamento adequado após avaliar você.
        Invisalign é marca de seu respectivo titular.
      </p>
    </div>
  </section>

  <CtaBand title="Pronto para dar o primeiro passo?" message={msg} context="ortodontia-final" />
</BaseLayout>
