---
import BaseLayout from '../layouts/BaseLayout.astro';
import Em from '../components/Em.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../config/site';
import { href } from '../utils/url';
import { genOrtoMaos, genInvisalign } from '../assets';

const msg = SERVICES.find((s) => s.slug === 'ortodontia-invisalign')!.whatsappMessage;
const faqs = [
  { q: 'Qual a diferença entre aparelho ortodôntico e Invisalign?', a: 'O aparelho ortodôntico é fixado nos dentes e ajustado pelo dentista. O Invisalign usa alinhadores transparentes removíveis, trocados em sequência. A melhor opção depende do seu caso.' },
  { q: 'O Invisalign serve para todos os casos?', a: 'Nem todos. A indicação depende da complexidade do alinhamento e das características de cada paciente, e é definida após a avaliação.' },
  { q: 'Adultos podem usar aparelho?', a: 'Sim. A avaliação define se o tratamento ortodôntico é indicado e qual a melhor abordagem em cada idade.' },
  { q: 'Quanto tempo dura o tratamento?', a: 'O tempo varia conforme o caso e a colaboração do paciente. O dentista apresenta uma estimativa no planejamento.' },
];
---
<BaseLayout title="Ortodontia e Invisalign em Bangu | ODONTO SPACE" description="Ortodontia e Invisalign em Bangu, Rio de Janeiro: avaliação para alinhar os dentes com aparelho ou alinhadores. Agende pelo WhatsApp." path="/ortodontia-invisalign" breadcrumb="Ortodontia e Invisalign" whatsappMessage={msg}>
  <section class="hn dark fx">
    <div class="wrap">
      <nav class="crumb label" aria-label="Você está em"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">Ortodontia e Invisalign</span></nav>
      <p class="label">Ortodontia e Invisalign</p>
      <h1><Em text="Ortodontia e *Invisalign* em Bangu" /></h1>
      <p class="lead">Alinhe seus dentes com a abordagem indicada para o seu caso: aparelho ortodôntico ou alinhadores Invisalign.</p>
      <div class="btn-row"><WhatsAppButton message={msg} context="ortodontia-hero" size="lg" label="Agendar avaliação ortodôntica" /></div>
    </div>
  </section>
  <div class="hn__strip"><Photo src={genInvisalign} alt="Alinhadores transparentes em um estojo branco sobre mármore" ratio="21 / 8" pos="50% 58%" eager illustrative widths={[800, 1200, 1600, 2000]} sizes="100vw" /></div>

  <section class="sec" style="padding-top:clamp(4rem,8vw,7rem)">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Duas abordagens</p><h2>O caminho ideal para <em>o seu sorriso</em></h2></div><p class="lead rv d1">Na avaliação, a ortodontista analisa o seu caso e explica qual opção faz mais sentido.</p></div>
      <div class="versus rv">
        <div class="versus__col"><p class="label">Abordagem 1</p><h3 class="versus__name">Ortodontia</h3><p>Tratamento que corrige o alinhamento dos dentes e a forma como eles se encaixam, contribuindo para a função e a estética do sorriso. É acompanhado por consultas periódicas para ajustes.</p></div>
        <div class="versus__col"><p class="label">Abordagem 2</p><h3 class="versus__name"><em>Invisalign</em></h3><p>Sistema de alinhadores transparentes e removíveis, trocados em sequência para mover os dentes gradualmente. A indicação depende da avaliação do seu caso.</p></div>
      </div>
    </div>
  </section>

  <section class="passo">
    <div class="wrap g12">
      <div class="passo__txt">
        <p class="label rv">Primeiro passo</p>
        <h2 class="rv d1"><Em text="Uma avaliação para planejar *o seu tratamento*" /></h2>
        <ul class="checks rv d2">
          <li><Icon name="check" size={18} /><span>Análise do alinhamento e da mordida</span></li>
          <li><Icon name="check" size={18} /><span>Apresentação das opções adequadas ao seu caso</span></li>
          <li><Icon name="check" size={18} /><span>Esclarecimento de dúvidas sobre etapas e acompanhamento</span></li>
        </ul>
        <div class="btn-row"><WhatsAppButton message={msg} context="ortodontia-meio" /></div>
      </div>
      <figure class="passo__img rv"><Photo src={genOrtoMaos} alt="Mãos enluvadas encaixando um alinhador transparente em um modelo dentário" ratio="3 / 2" pos="50% 50%" illustrative sizes="(max-width: 860px) 100vw, 58vw" /></figure>
    </div>
  </section>

  <section class="sec">
    <div class="wrap faqgrid">
      <div><p class="label">Dúvidas frequentes</p><h2>Perguntas sobre <em>ortodontia</em></h2><p class="notice">Conteúdo informativo. Somente um cirurgião-dentista pode indicar o tratamento adequado após avaliar você. Invisalign é marca de seu respectivo titular.</p></div>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>
</BaseLayout>
