---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Pic from '../components/Pic.astro';
import { SITE, MAPS_URL, ADDRESS_FULL, serviceMessage, GENERAL_WHATSAPP_MESSAGE } from '../config/site';
import { whatsappLink } from '../utils/whatsapp';
import { href } from '../utils/url';
import { genConsultorio, genRecepcao, genInstrumentos, genImplanteCoroa, genProteseCoroas, genHomeOrto, genHomeEstetica, genHomeClinica } from '../assets';

const wa = whatsappLink();
const a = SITE.address;
/** Respostas do guia "Como podemos ajudar?" (o script apenas as exibe). */
const replies = {
  dentes: { t: 'Existem caminhos diferentes para repor dentes ausentes, como implantes e próteses. O dentista indica o melhor depois de avaliar o seu caso.', links: [['Ver sobre implantes', href('/implantes-dentarios')], ['Ver sobre próteses', href('/proteses-dentarias')]], m: 'Olá! Faltam dentes e gostaria de saber quais são as opções na ODONTO SPACE.' },
  alinhar: { t: 'A ortodontia reúne diferentes possibilidades de tratamento. Vale conhecer cada uma e conversar sobre o seu caso.', links: [['Conhecer as possibilidades', href('/ortodontia')]], m: 'Olá! Gostaria de agendar uma avaliação de ortodontia na ODONTO SPACE.' },
  estetica: { t: 'Podemos conversar sobre estética do sorriso, como o clareamento dental. A indicação e os limites de cada procedimento dependem da avaliação.', links: [], m: serviceMessage('Estética do Sorriso') },
  check: { t: 'Uma consulta de avaliação ajuda a cuidar da saúde bucal e a identificar alterações cedo.', links: [], m: serviceMessage('Clínica geral') },
  nao: { t: 'Sem problema. Conte o que você sente ou deseja e orientamos o melhor primeiro passo.', links: [], m: 'Olá! Não sei por onde começar e gostaria de uma orientação da ODONTO SPACE.' },
};
const chips = [['dentes', 'Faltam dentes'], ['alinhar', 'Quero alinhar os dentes'], ['estetica', 'Quero um sorriso mais harmônico'], ['check', 'Check-up e prevenção'], ['nao', 'Ainda não sei']];
---

<BaseLayout
  title="ODONTO SPACE | Dentista em Bangu, Rio de Janeiro"
  description="ODONTO SPACE, clínica odontológica em Bangu, Rio de Janeiro: implantes, próteses, ortodontia, Invisalign, estética do sorriso e clínica geral. Agende sua avaliação pelo WhatsApp."
  path="/"
  includeBusinessSchema
>
 <section class="hero">
  <div class="hero__txt">
    <p class="label fx">Clínica odontológica · Bangu, Rio de Janeiro</p>
    <h1><span class="ln"><span>Seu sorriso,</span></span><span class="ln"><span><em>com calma</em></span></span><span class="ln"><span>e clareza.</span></span></h1>
    <p class="lead fx">Na ODONTO SPACE, cada tratamento começa com uma conversa e uma avaliação. Explicamos as opções e as etapas, para você decidir com segurança.</p>
    <div class="guide fx" id="guia" data-replies={JSON.stringify(replies)}>
      <p class="guide__q" id="guia-q">Como podemos ajudar?</p>
      <div class="chips" role="group" aria-labelledby="guia-q">
        {chips.map(([k, t]) => <button class="chip" type="button" data-k={k} aria-pressed="false">{t}</button>)}
      </div>
      <div class="reply" id="reply" aria-live="polite"><p style="color:var(--mute)">Escolha uma opção e mostramos o melhor primeiro passo. Se preferir, é só chamar direto.</p></div>
      <p class="hero__alt">Prefere conversar agora? <a href={wa} target="_blank" rel="noopener noreferrer" data-wa="inicio-hero">Chamar no WhatsApp · {SITE.whatsapp.display}</a></p>
    </div>
  </div>
  <div class="hero__photo"><div class="ph"><Pic src={genConsultorio} alt="Consultório odontológico claro e moderno, com luz natural" pos="20% 50%" sizes="(max-width: 900px) 100vw, 50vw" widths={[480, 800, 1200, 1600]} eager priority /></div></div>
 </section>

 <section class="visit">
  <div class="wrap">
   <div class="visit__head"><p class="label rv">Sua visita</p><h2 class="rv d1">Um lugar calmo, para você entender o que vai acontecer.</h2><p class="lead rv d2">Da recepção à preparação, cada ambiente existe para que você se sinta à vontade e bem informado.</p></div>
   <div class="tri" tabindex="0" role="region" aria-label="Os três momentos da visita: recepção, avaliação e preparação">
    <figure class="fg a rv"><div class="ph"><Pic src={genRecepcao} alt="Recepção clara e acolhedora de clínica odontológica" sizes="(max-width: 860px) 80vw, 40vw" widths={[480, 800, 1200]} /></div><figcaption class="fig"><b>1 · Recepção</b>O primeiro contato é calmo e sem pressa.</figcaption></figure>
    <figure class="fg b rv d1"><div class="ph"><Pic src={genConsultorio} alt="Detalhe do consultório: bancada, equipamentos e banqueta" pos="100% 50%" sizes="(max-width: 860px) 80vw, 40vw" widths={[480, 800, 1200]} /></div><figcaption class="fig"><b>2 · Avaliação</b>Conversa e exame clínico no consultório.</figcaption></figure>
    <figure class="fg c rv d2"><div class="ph"><Pic src={genInstrumentos} alt="Instrumentos odontológicos esterilizados sobre uma bandeja" sizes="(max-width: 860px) 70vw, 30vw" widths={[480, 800, 1200]} /></div><figcaption class="fig"><b>3 · Preparação</b>Instrumentais organizados para cada consulta.</figcaption></figure>
   </div>
   <p class="hint">Deslize para ver os três momentos →</p>
  </div>
 </section>

 <section class="vows">
  <div class="wrap g12">
   <div style="grid-column:1/7"><p class="label rv">Nossos combinados</p><h2 class="rv d1" style="grid-column:auto">Antes de qualquer tratamento, uma conversa.</h2></div>
   <ol class="vows__l rv d1">
     <li>Avaliação individual antes de qualquer indicação.</li>
     <li>Explicação das opções e das etapas de cada tratamento.</li>
     <li>Contato direto com a equipe pelo WhatsApp.</li>
     <li>Informação educativa: quem indica o tratamento é o dentista, depois de avaliar você.</li>
   </ol>
  </div>
 </section>

 <section class="need" id="servicos">
  <div class="wrap">
   <div class="need__head"><p class="label rv">Do que você precisa?</p><h2 class="rv d1">Comece pelo que você quer resolver.</h2></div>
   <div class="g12">
    <div class="panel" aria-hidden="true"><div class="panel__stage">
      <div class="panel__item on duo" data-p="0"><div class="ph"><Pic src={genImplanteCoroa} alt="" pos="50% 58%" sizes="(max-width: 860px) 0px, 25vw" widths={[480, 800]} /></div><div class="ph"><Pic src={genProteseCoroas} alt="" pos="50% 60%" sizes="(max-width: 860px) 0px, 25vw" widths={[480, 800]} /></div></div>
      <div class="panel__item" data-p="1"><div class="ph"><Pic src={genHomeOrto} alt="" pos="50% 35%" sizes="(max-width: 860px) 0px, 40vw" widths={[480, 800, 1200]} /></div></div>
      <div class="panel__item" data-p="2"><div class="ph"><Pic src={genHomeEstetica} alt="" pos="50% 55%" sizes="(max-width: 860px) 0px, 40vw" widths={[480, 800, 1200]} /></div></div>
      <div class="panel__item" data-p="3"><div class="ph"><Pic src={genHomeClinica} alt="" pos="50% 55%" sizes="(max-width: 860px) 0px, 40vw" widths={[480, 800, 1200]} /></div></div>
     </div></div>
    <ul class="needs" data-needs>
     <li data-i="0"><span class="label">Implantes e próteses</span><h3>Faltam dentes?</h3><p>Existem caminhos diferentes para repor dentes ausentes. O dentista indica o melhor após avaliar o seu caso.</p><div class="acts"><a class="link" href={href('/implantes-dentarios')}>Implantes dentários</a><a class="link" href={href('/proteses-dentarias')}>Próteses dentárias</a></div><button class="tg" type="button" aria-expanded="false" aria-label="Mostrar imagem de implantes e próteses">+</button><div class="peek duo"><div class="ph" style="--ar:1/1"><Pic src={genImplanteCoroa} alt="Implante dentário de titânio ao lado de uma coroa de cerâmica" pos="50% 58%" sizes="(max-width: 860px) 45vw, 0px" widths={[320, 480, 800]} /></div><div class="ph" style="--ar:1/1"><Pic src={genProteseCoroas} alt="Coroas e ponte de cerâmica ao lado de um modelo dentário" pos="58% 60%" sizes="(max-width: 860px) 45vw, 0px" widths={[320, 480, 800]} /></div></div></li>
     <li data-i="1"><span class="label">Ortodontia</span><h3>Quer alinhar os dentes?</h3><p>A ortodontia reúne diferentes possibilidades de tratamento, entre elas o aparelho e os alinhadores transparentes.</p><div class="acts"><a class="link" href={href('/ortodontia')}>Conhecer as possibilidades</a></div><button class="tg" type="button" aria-expanded="false" aria-label="Mostrar imagem de ortodontia">+</button><div class="peek"><div class="ph" style="--ar:4/3"><Pic src={genHomeOrto} alt="Jovem sorrindo com aparelho ortodôntico metálico" pos="50% 30%" sizes="(max-width: 860px) 92vw, 0px" widths={[480, 800]} /></div></div></li>
     <li data-i="2"><span class="label">Estética do Sorriso</span><h3>Quer um sorriso mais harmônico?</h3><p>Podemos conversar sobre cuidados estéticos, como o clareamento dental, conforme a indicação do dentista após a avaliação.</p><div class="acts"><a class="link" href={whatsappLink(serviceMessage('Estética do Sorriso'))} target="_blank" rel="noopener noreferrer" data-wa="inicio-estetica">Conversar pelo WhatsApp</a></div><button class="tg" type="button" aria-expanded="false" aria-label="Mostrar imagem de estética do sorriso">+</button><div class="peek"><div class="ph" style="--ar:4/3"><Pic src={genHomeEstetica} alt="Guia de cores de dente e espelho de mão sobre uma bancada clara" pos="50% 58%" sizes="(max-width: 860px) 92vw, 0px" widths={[480, 800]} /></div></div></li>
     <li data-i="3"><span class="label">Clínica geral</span><h3>Quer cuidar e prevenir?</h3><p>Avaliação, prevenção e cuidados com a saúde bucal para o dia a dia.</p><div class="acts"><a class="link" href={whatsappLink(serviceMessage('Clínica geral'))} target="_blank" rel="noopener noreferrer" data-wa="inicio-clinica-geral">Agendar uma consulta</a></div><button class="tg" type="button" aria-expanded="false" aria-label="Mostrar imagem de clínica geral">+</button><div class="peek"><div class="ph" style="--ar:4/3"><Pic src={genHomeClinica} alt="Espelho clínico, sonda, escova e fio dental sobre uma bancada clara" pos="50% 58%" sizes="(max-width: 860px) 92vw, 0px" widths={[480, 800]} /></div></div></li>
    </ul>
   </div>
  </div>
 </section>

 <section class="close on-deep">
  <div class="wrap g12">
   <div class="close__l"><p class="label rv">Vamos conversar?</p><h2 class="rv d1">Seu primeiro passo cabe numa mensagem.</h2><p class="rv d2">A avaliação é marcada pelo WhatsApp. Conte o que você procura e a equipe orienta o melhor começo.</p>
     <div class="row rv d2"><a class="btn btn--lg" href={wa} target="_blank" rel="noopener noreferrer" data-wa="inicio-fechamento"><Icon name="whatsapp" size={26} /><span>Agendar avaliação pelo WhatsApp</span></a></div>
     <a class="num rv d2" href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener noreferrer" data-wa="inicio-numero">{SITE.whatsapp.display}</a></div>
   <div class="close__r rv d1"><p class="label">Onde estamos</p><address>{a.street} – {a.complement}<br />{a.neighborhood}, {a.city} – {a.state}, CEP {a.postalCode}</address><div class="close__links"><a class="link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Como chegar →</a>{SITE.instagram && <a class="link" href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram @clinicaodontospace (abre em nova aba)" data-social="instagram-inicio"><Icon name="instagram" size={18} /><span>Instagram</span></a>}</div></div>
  </div>
 </section>

 <script>
   import '../scripts/home';
 </script>
</BaseLayout>
