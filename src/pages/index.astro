---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { SERVICES, SITE, MAPS_URL } from '../config/site';
import { href } from '../utils/url';
import { whatsappLink } from '../utils/whatsapp';
import { genConsultorio, genInstrumentos, genRecepcao, genImplanteCoroa, genProteseCoroas, genInvisalign } from '../assets';

const pillars = [
  { t: 'Tratamento individualizado', d: 'Cada paciente tem necessidades diferentes. O tratamento parte do seu caso.' },
  { t: 'Planejamento antes do procedimento', d: 'Avaliamos, explicamos as opções e definimos as etapas com você.' },
  { t: 'Prevenção e acompanhamento', d: 'Consultas periódicas ajudam a manter a saúde bucal e identificar alterações cedo.' },
  { t: 'Atendimento humanizado', d: 'Acolhimento, segurança e atenção em cada etapa, sem pressa.' },
];
// Imagem de cada especialidade no painel compartilhado (as sem foto própria mostram a palavra em tipografia).
const svcImg: Record<string, { src: ImageMetadata; pos: string; alt: string } | undefined> = {
  'Implantes dentários': { src: genImplanteCoroa, pos: '50% 50%', alt: 'Implante dentário de titânio ao lado de uma coroa de cerâmica' },
  'Próteses dentárias': { src: genProteseCoroas, pos: '58% 55%', alt: 'Coroas e ponte de cerâmica ao lado de um modelo de gesso' },
  'Ortodontia e Invisalign': { src: genInvisalign, pos: '42% 55%', alt: 'Alinhadores transparentes em um estojo branco' },
};
const word: Record<string, string> = { 'Estética do Sorriso': 'Estética', 'Clínica geral': 'Clínica geral' };
const svcUrl = (s: (typeof SERVICES)[number]) => (s.slug ? href(`/${s.slug}`) : s.title === 'Estética do Sorriso' ? '#estetica' : whatsappLink(s.whatsappMessage));
const steps = [
  { t: 'Conversa', d: 'Entendemos o seu histórico e o que você espera.' },
  { t: 'Exame clínico', d: 'O dentista avalia a sua boca e solicita exames, se necessário.' },
  { t: 'Plano explicado', d: 'Apresentamos as opções e as etapas antes de começar.' },
  { t: 'Acompanhamento', d: 'Retornos para acompanhar a evolução do tratamento.' },
];
const estetica = SERVICES.find((s) => s.title === 'Estética do Sorriso')!;
---
<BaseLayout
  title="ODONTO SPACE | Dentista em Bangu, Rio de Janeiro"
  description="Clínica odontológica em Bangu, Rio de Janeiro: implantes, próteses, ortodontia e Invisalign, estética do sorriso e clínica geral. Agende sua avaliação pelo WhatsApp."
  path="/"
  includeBusinessSchema
>
  <section class="hm-open">
    <div class="wrap">
      <p class="label fx-in">Clínica odontológica · Bangu, Rio de Janeiro</p>
      <h1 class="hm-title"><span class="ln"><span>Cuidar do sorriso</span></span><span class="ln"><span><em>vai além</em> da</span></span><span class="ln"><span>estética.</span></span></h1>
      <div class="g12 hm-open__row">
        <div class="hm-open__text fx-in">
          <p class="lead">Na ODONTO SPACE, cada tratamento parte de uma avaliação: entendemos o seu caso, planejamos as etapas e buscamos saúde, função, harmonia e confiança de forma individualizada.</p>
          <div class="row"><WhatsAppButton context="home-hero" size="lg" /></div>
          <p class="micro">{SITE.address.street} · {SITE.address.neighborhood}</p>
        </div>
        <Photo class="hm-open__photo" src={genConsultorio} alt="Consultório odontológico claro e moderno, com luz natural" ratio="5 / 4" pos="0% 50%" eager n="01" widths={[800, 1200, 1600, 2000]} sizes="100vw" />
      </div>
    </div>
  </section>

  <section class="hm-visit">
    <div class="wrap g12">
      <div class="hm-visit__side">
        <p class="label rv">Nossa forma de cuidar</p>
        <h2 class="rv d1">Uma visita pensada em três momentos.</h2>
        <p class="lead rv d2">Da recepção à preparação, cada ambiente existe para que você entenda o que vai acontecer.</p>
        <ul class="pil rv d3">
          {pillars.map((p) => <li><h3>{p.t}</h3><p>{p.d}</p></li>)}
        </ul>
        <p class="rv" style="margin:2rem 0 0"><a class="link" href={href('/a-clinica-e-equipe')}>Conheça a clínica e a equipe <Icon name="arrow" size={16} /></a></p>
      </div>
      <div class="hm-visit__grid">
        <Photo class="v1 rv" src={genRecepcao} alt="Recepção clara e acolhedora de clínica odontológica" ratio="16 / 9" n="02" sizes="(max-width: 860px) 100vw, 58vw"><b>01 · Recepção</b>O primeiro contato é calmo e sem pressa.</Photo>
        <Photo class="v2 rv d1" src={genConsultorio} alt="Detalhe do consultório: bancada, equipamentos e banqueta" ratio="2 / 3" pos="100% 50%" n="03" widths={[800, 1200, 1600, 2000]} sizes="90vw"><b>02 · Ambiente clínico</b>Detalhe do consultório.</Photo>
        <Photo class="v3 rv d2" src={genInstrumentos} alt="Instrumentos odontológicos esterilizados sobre uma bandeja" ratio="5 / 4" n="04" widths={[800, 1200, 1611]} sizes="60vw"><b>03 · Preparação</b>Instrumentais organizados para cada consulta.</Photo>
      </div>
    </div>
  </section>

  <section class="hm-man on-ice">
    <div class="wrap">
      <p class="label rv">Manifesto</p>
      <p class="man" data-man>Cuidar do sorriso é entender cada caso, planejar o tratamento e buscar saúde, função, harmonia e confiança de forma individualizada.</p>
      <p class="hm-man__sign rv">ODONTO SPACE · Bangu</p>
    </div>
  </section>

  <section class="hm-svc" id="servicos">
    <div class="wrap">
      <div class="hm-svc__head"><p class="label rv">Serviços</p><h2 class="rv d1">Tratamentos para cada necessidade.</h2></div>
      <div class="g12">
        <div class="hm-panel" aria-hidden="true">
          <div class="hm-panel__stage">
            {SERVICES.map((s, i) => {
              const im = svcImg[s.title];
              return (
                <div class:list={['hm-panel__item', i === 0 && 'on']} data-panel={i}>
                  {im ? <Photo bg src={im.src} alt="" pos={im.pos} widths={[800, 1200, 1600, 2000]} sizes="95vw" /> : <span class="hm-panel__word">{word[s.title] ?? s.title}</span>}
                </div>
              );
            })}
          </div>
          <p class="fig"><span class="fig__tag">Imagens ilustrativas geradas por IA</span></p>
        </div>
        <ol class="idx" data-idx>
          {SERVICES.map((s, i) => {
            const ext = !s.slug && s.title !== 'Estética do Sorriso';
            const im = svcImg[s.title];
            return (
              <li data-i={i}>
                <a class="idx__row" href={svcUrl(s)} {...(ext ? { target: '_blank', rel: 'noopener noreferrer', 'data-wa': `home-servico-${i}` } : {})}>
                  <span class="idx__n">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{s.title}</h3>
                  <p>{s.short}</p>
                  <span class="idx__go"><Icon name="arrow" size={26} /></span>
                </a>
                <button class="idx__tg" type="button" aria-expanded="false" aria-label={`Ver imagem de ${s.title}`}>+</button>
                {im && <div class="idx__peek"><Photo src={im.src} alt={im.alt} ratio="4 / 3" pos={im.pos} widths={[800, 1200, 1600]} sizes="100vw" /></div>}
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <section class="hm-est on-mist" id="estetica">
        <div class="wrap g12">
      <div class="hm-est__txt">
        <p class="label rv">Estética do Sorriso</p>
        <h2 class="rv d1">Estética com saúde e <em>sem promessa de resultado.</em></h2>
        <p class="lead rv d2">A estética do sorriso pode incluir cuidados como o clareamento dental. A indicação, as opções e os limites de cada procedimento são definidos pelo dentista após avaliar o seu caso.</p>
        <div class="row rv d3"><WhatsAppButton context="home-estetica" message={estetica.whatsappMessage} label="Conversar sobre estética do sorriso" /></div>
      </div>
    </div>
  </section>

  <section class="hm-flow">
    <div class="wrap">
      <div class="hm-flow__head"><p class="label rv">Como é a avaliação</p><h2 class="rv d1">Do primeiro contato ao plano de tratamento.</h2></div>
      {steps.map((s, i) => (
        <div class="step rv">
          <span class="step__n" aria-hidden="true">{i + 1}</span>
          <div class="step__t"><h3>{s.t}</h3><p>{s.d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="hm-end on-deep" id="localizacao">
        <div class="wrap g12">
      <div class="hm-end__addr">
        <p class="label rv">Localização</p>
        <h2 class="rv d1">Rua Francisco Real, 1910</h2>
        <address class="rv d2">Sala 201<br />{SITE.address.neighborhood} – {SITE.address.city}/{SITE.address.state}</address>
        <p class="rv d3" style="margin:1.4rem 0 0"><a class="link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="arrow" size={16} /></a></p>
      </div>
      <div class="hm-end__wa rv d2">
        <p class="label">WhatsApp</p>
        <a class="hm-end__num" href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener noreferrer" data-wa="home-fechamento-numero">{SITE.whatsapp.display}</a>
        <WhatsAppButton context="home-fechamento" variant="solid" label="Agendar avaliação" />
      </div>
    </div>
  </section>
<script is:inline>
  (function () {
    var idx = document.querySelector('[data-idx]'); if (!idx) return;
    var items = [].slice.call(idx.children), panels = [].slice.call(document.querySelectorAll('[data-panel]'));
    function show(i) { panels.forEach(function (p, k) { p.classList.toggle('on', k === i); }); }
    items.forEach(function (li, i) {
      var row = li.querySelector('.idx__row'), tg = li.querySelector('.idx__tg');
      row.addEventListener('mouseenter', function () { show(i); });
      row.addEventListener('focus', function () { show(i); });
      if (tg) tg.addEventListener('click', function () { var o = li.classList.toggle('is-open'); tg.setAttribute('aria-expanded', String(o)); });
    });
  })();
</script>
</BaseLayout>
