---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Em from '../components/Em.astro';
import { SERVICES, SITE } from '../config/site';
import { href } from '../utils/url';
import { whatsappLink } from '../utils/whatsapp';
import { genConsultorio, genInstrumentos, genRecepcao, genPacienteIA } from '../assets';

const pillars = [
  { t: 'Tratamento individualizado', d: 'Cada paciente tem necessidades diferentes. O tratamento parte do seu caso.' },
  { t: 'Planejamento antes do procedimento', d: 'Avaliamos, explicamos as opções e definimos as etapas com você.' },
  { t: 'Prevenção e acompanhamento', d: 'Consultas periódicas ajudam a manter a saúde bucal e identificar alterações cedo.' },
  { t: 'Atendimento humanizado', d: 'Acolhimento, segurança e atenção em cada etapa, sem pressa.' },
];
const svcUrl = (s: (typeof SERVICES)[number]) => s.slug ? href(`/${s.slug}`) : s.title === 'Estética do Sorriso' ? '#estetica' : whatsappLink(s.whatsappMessage);
---
<BaseLayout
  title="ODONTO SPACE | Dentista em Bangu, Rio de Janeiro"
  description="Clínica odontológica em Bangu, Rio de Janeiro: implantes, próteses, ortodontia e Invisalign, estética do sorriso e clínica geral. Agende sua avaliação pelo WhatsApp."
  path="/"
  includeBusinessSchema
>
  <section class="hx dark fx">
    <Photo src={genConsultorio} alt="Consultório odontológico claro e moderno, com luz natural" ratio="auto" pos="38% 50%" eager widths={[800, 1200, 1600, 2000]} sizes="100vw" />
    <span class="ph__tag ph__tag--sec">Imagem ilustrativa</span>
    <div class="wrap hx__in">
      <p class="label">Clínica odontológica · Bangu, Rio de Janeiro</p>
      <h1><span class="ln"><span>Cuidar do sorriso</span></span><span class="ln"><span><em>vai além</em> da</span></span><span class="ln"><span>estética.</span></span></h1>
      <p class="lead">Na ODONTO SPACE, cada tratamento parte de uma avaliação: entendemos o seu caso, planejamos as etapas e buscamos saúde, função, harmonia e confiança de forma individualizada.</p>
      <div class="btn-row">
        <WhatsAppButton context="home-hero" size="lg" />
        <a class="link" href="#servicos">Conheça os serviços <Icon name="arrow" size={16} /></a>
      </div>
    </div>
    <div class="facts"><div class="wrap"><div><em>Endereço</em>{SITE.address.street} · {SITE.address.neighborhood}</div><div><em>WhatsApp</em>{SITE.whatsapp.display}</div><div><em>Agendamento</em>Avaliação marcada pelo WhatsApp</div></div></div>
  </section>

  <section class="cuidar">
    <div class="wrap g12">
      <div class="cuidar__txt">
        <p class="label rv">Nossa forma de cuidar</p>
        <p class="man" data-man>Cuidar do sorriso é entender cada caso, planejar o tratamento e buscar saúde, função, harmonia e confiança de forma individualizada.</p>
        <div class="pil">
          {pillars.map((p, i) => <div class={`rv d${i % 3}`}><h3>{p.t}</h3><p>{p.d}</p></div>)}
        </div>
        <p class="rv" style="margin:2.2rem 0 0"><a class="link" href={href('/a-clinica-e-equipe')}>Conheça a clínica e a equipe <Icon name="arrow" size={16} /></a></p>
      </div>
      <figure class="cuidar__img rv">
        <Photo src={genInstrumentos} alt="Instrumentos odontológicos esterilizados sobre uma bandeja" ratio="4 / 5" pos="50% 50%" illustrative sizes="(max-width: 860px) 76vw, 32vw" />
      </figure>
    </div>
  </section>

  <section class="idx-sec" id="servicos">
    <div class="wrap idx-grid">
      <div class="idx-head">
        <p class="label rv">Serviços</p>
        <h2 class="rv d1">Tratamentos para <em>cada necessidade</em></h2>
        <p class="lead rv d2">Toda indicação começa por uma avaliação profissional. Conheça as áreas em que atuamos.</p>
      </div>
      <ol class="idx">
        {SERVICES.map((s, i) => {
          const ext = !s.slug && s.title !== 'Estética do Sorriso';
          return (
            <li class="rv"><a class="idx__row" href={svcUrl(s)} {...(ext ? { target: '_blank', rel: 'noopener noreferrer', 'data-wa': `home-servico-${i}` } : {})}>
              <span class="idx__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
              <span class="idx__go"><Icon name="arrow" size={26} /></span>
            </a></li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="band dark">
    <Photo src={genRecepcao} alt="Recepção clara e acolhedora de clínica odontológica" ratio="auto" pos="50% 55%" sizes="100vw" widths={[800, 1200, 1600, 2000]} />
    <span class="ph__tag ph__tag--sec">Imagem ilustrativa</span>
    <div class="wrap rv">
      <p class="label">Planejamento antes do procedimento</p>
      <h2>Entender o seu caso vem antes de qualquer tratamento.</h2>
      <p>Na avaliação, explicamos as opções e as etapas com clareza, para você decidir com segurança.</p>
      <div class="btn-row" style="margin-top:1.2rem"><WhatsAppButton context="home-banner" label="Agendar avaliação" /></div>
    </div>
  </section>

  <section class="est" id="estetica">
    <div class="wrap g12">
      <div class="est__txt">
        <p class="label rv">Estética do Sorriso</p>
        <h2 class="rv d1">Um sorriso em harmonia com <em>o seu rosto e a sua saúde.</em></h2>
        <p class="lead rv d2">A estética do sorriso pode incluir cuidados como o clareamento dental. A indicação, as opções e os limites de cada procedimento são definidos pelo dentista após avaliar o seu caso, sem promessa de resultado.</p>
        <div class="btn-row rv d3"><WhatsAppButton context="home-estetica" message={SERVICES.find((s) => s.title === 'Estética do Sorriso')!.whatsappMessage} label="Conversar sobre estética do sorriso" /></div>
      </div>
      <figure class="est__img rv">
        <Photo src={genPacienteIA} alt="Mulher sorrindo em um consultório moderno (imagem gerada por IA)" ratio="4 / 5" pos="50% 28%" illustrative ai sizes="(max-width: 860px) 80vw, 38vw" />
      </figure>
    </div>
  </section>

  <section class="sec sec--dark dark">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Como é a avaliação</p><h2>Do primeiro contato ao <em>plano de tratamento</em></h2></div></div>
      <ol class="stp" data-stp>
        <li class="rv"><span class="label">Etapa 1</span><h3>Conversa</h3><p>Entendemos o seu histórico e o que você espera.</p></li>
        <li class="rv d1"><span class="label">Etapa 2</span><h3>Exame clínico</h3><p>O dentista avalia a sua boca e solicita exames, se necessário.</p></li>
        <li class="rv d2"><span class="label">Etapa 3</span><h3>Plano explicado</h3><p>Apresentamos as opções e as etapas antes de começar.</p></li>
        <li class="rv d3"><span class="label">Etapa 4</span><h3>Acompanhamento</h3><p>Retornos para acompanhar a evolução do tratamento.</p></li>
      </ol>
    </div>
  </section>
</BaseLayout>
