---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Em from '../components/Em.astro';
import { SERVICES, SITE, MAPS_URL } from '../config/site';
import { href } from '../utils/url';
import { proprietario, ortodontista, pacienteSorrindo, implanteModelo, proteseLab, modeloMaos, consultaAvaliacao, consultorioClaro, consultorioTablet, sorrisoNatural } from '../assets';

const cardImg: Record<string, { src: ImageMetadata; pos: string; alt: string }> = {
  'Implantes dentários': { src: implanteModelo, pos: '50% 50%', alt: 'Modelo anatômico de implante dentário' },
  'Próteses dentárias': { src: proteseLab, pos: '50% 55%', alt: 'Prótese dentária sobre modelo de gesso em laboratório' },
  'Ortodontia e Invisalign': { src: modeloMaos, pos: '50% 50%', alt: 'Mãos de profissional segurando um modelo dentário' },
  'Endodontia': { src: consultaAvaliacao, pos: '72% 42%', alt: 'Profissional realizando avaliação odontológica em paciente' },
  'Clínica geral': { src: consultorioClaro, pos: '50% 34%', alt: 'Profissional atendendo paciente em consultório claro' },
};
const pillars = [
  { t: 'Tratamento individualizado', d: 'Cada paciente tem necessidades diferentes. O tratamento parte do seu caso.' },
  { t: 'Planejamento antes do procedimento', d: 'Avaliamos, explicamos as opções e definimos as etapas com você.' },
  { t: 'Prevenção e acompanhamento', d: 'Consultas periódicas ajudam a manter a saúde bucal e identificar alterações cedo.' },
  { t: 'Atendimento humanizado', d: 'Acolhimento, segurança e atenção em cada etapa, sem pressa.' },
];
---
<BaseLayout
  title="ODONTO SPACE | Dentista em Bangu, Rio de Janeiro"
  description="Clínica odontológica em Bangu, Rio de Janeiro: implantes, próteses, ortodontia e Invisalign, endodontia e acompanhamento. Agende sua avaliação pelo WhatsApp."
  path="/"
  includeBusinessSchema
>
  <section class="hero hero--home dark">
    <span class="arc a" aria-hidden="true"></span><span class="arc b" aria-hidden="true"></span>
    <div class="wrap">
      <div>
        <p class="label">Clínica odontológica · Bangu, Rio de Janeiro</p>
        <h1><span class="ln"><span>Cuidar do sorriso</span></span><span class="ln"><span><em>vai além</em> da</span></span><span class="ln"><span>estética.</span></span></h1>
        <p class="lead">Na ODONTO SPACE, cada tratamento parte de uma avaliação: entendemos o seu caso, planejamos as etapas e buscamos saúde, função, harmonia e confiança de forma individualizada.</p>
        <div class="btn-row">
          <WhatsAppButton context="home-hero" size="lg" variant="light" />
          <a class="link" href="#servicos">Conheça os serviços <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="stage">
        <Photo class="ph1 ph--arch" src={proprietario} alt={SITE.owner.photoAlt} ratio="auto" pos="50% 14%" eager widths={[480, 800, 1000]} sizes="(max-width: 900px) 70vw, 380px" />
        <Photo class="ph2" src={ortodontista} alt={SITE.orthodontist.photoAlt} pos="50% 14%" eager widths={[240, 400]} sizes="150px" />
        <div class="cap"><b>{SITE.owner.name}</b>{SITE.owner.role}</div>
      </div>
    </div>
    <div class="facts"><div class="wrap"><div><em>Endereço</em>{SITE.address.street} · {SITE.address.neighborhood}</div><div><em>WhatsApp</em>{SITE.whatsapp.display}</div><div><em>Agendamento</em>Avaliação marcada pelo WhatsApp</div></div></div>
  </section>

  <section class="sec">
    <div class="wrap split split--img-left">
      <Photo class="split__img rv" src={pacienteSorrindo} alt="Paciente sorrindo em consultório odontológico moderno, segurando um espelho" ratio="4 / 5" pos="42% 50%" illustrative zoom sizes="(max-width: 860px) 100vw, 46vw" />
      <div>
        <p class="label rv">Nossa forma de cuidar</p>
        <p class="man" data-man>É entender cada caso, planejar o tratamento e buscar saúde, função, harmonia e confiança de forma individualizada.</p>
        <div class="pil">
          {pillars.map((p, i) => <div class={`rv d${i % 3}`}><h3>{p.t}</h3><p>{p.d}</p></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--mist" id="servicos">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Serviços</p><h2>Tratamentos para <em>cada necessidade</em></h2></div><p class="lead rv d1">Toda indicação começa por uma avaliação profissional. Conheça as áreas em que atuamos.</p></div>
      <div class="cards">
        {SERVICES.map((s, i) => {
          const im = cardImg[s.title];
          const inner = (<>
            <Photo src={im.src} alt={im.alt} pos={im.pos} illustrative={false} zoom sizes="(max-width: 900px) 100vw, 33vw" />
            <div class="card__in">
              <h3>{s.title}</h3>
              <p>{s.short}</p>
              {s.slug ? <span class="go">Saiba mais <Icon name="arrow" size={16} /></span> : <span class="tag">Consulte a equipe</span>}
            </div>
          </>);
          const cls = ['card', 'rv', `d${i % 3}`, i === 0 ? 'first' : '', i > 2 ? 'wide' : ''].join(' ');
          return s.slug ? <a class={cls} href={href(`/${s.slug}`)}>{inner}</a> : <div class={cls}>{inner}</div>;
        })}
      </div>
      <p class="small rv" style="margin:1.4rem 0 0;color:var(--mute)">Fotografias de banco, ilustrativas, usadas até a inclusão das imagens reais da clínica.</p>
    </div>
  </section>

  <section class="banner dark">
    <Photo src={consultorioTablet} alt="Profissional mostrando informações em um tablet a uma paciente no consultório" pos="50% 40%" sizes="100vw" widths={[800, 1200, 1600, 2000]} illustrative={false} />
    <div class="wrap rv">
      <div>
        <p class="label">Planejamento antes do procedimento</p>
        <h2>Entender o seu caso vem antes de qualquer tratamento.</h2>
        <p>Na avaliação, explicamos as opções e as etapas com clareza, para você decidir com segurança.</p>
        <div class="btn-row" style="margin-top:1.2rem"><WhatsAppButton context="home-banner" variant="light" label="Agendar avaliação" /></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Equipe</p><h2>Quem cuida do <em>seu sorriso</em></h2></div><a class="link rv d1" href={href('/a-clinica-e-equipe')}>Conheça a clínica e a equipe <Icon name="arrow" size={16} /></a></div>
      <div class="team">
        <figure class="pc rv"><Photo src={proprietario} alt={SITE.owner.photoAlt} pos="50% 14%" widths={[480, 800, 1000]} sizes="(max-width: 700px) 100vw, 560px" zoom /><figcaption><b>{SITE.owner.name}</b><span>{SITE.owner.title} · {SITE.owner.role}</span></figcaption></figure>
        <figure class="pc b rv d2"><Photo src={ortodontista} alt={SITE.orthodontist.photoAlt} pos="50% 14%" widths={[400, 520, 800]} sizes="(max-width: 700px) 80vw, 420px" zoom /><figcaption><b>Ortodontista</b><span>Ortodontia · nome e CRO em breve</span></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="sec sec--dark dark">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Como é a avaliação</p><h2>Do primeiro contato ao <em>plano de tratamento</em></h2></div></div>
      <ol class="stp" data-stp>
        <li class="rv"><span class="label">Etapa 1</span><h3>Conversa</h3><p>Entendemos o seu histórico e o que você espera.</p></li>
        <li class="rv d1"><span class="label">Etapa 2</span><h3>Exame clínico</h3><p>O dentista avalia a sua boca e solicita exames, se necessário.</p></li>
        <li class="rv d2"><span class="label">Etapa 3</span><h3>Plano explicado</h3><p>Apresentamos as opções e as etapas antes de começar.</p></li>
        <li class="rv d3"><span class="label">Etapa 4</span><h3>Acompanhamento</h3><p>Retornos para acompanhar a evolução do tratamento.</p></li>
      </ol>
    </div>
  </section>

  <section class="sec" id="localizacao">
    <div class="wrap loc">
      <div class="panel dark rv">
        <div>
          <p class="label">Localização</p>
          <h2>Venha nos visitar em <em>Bangu</em></h2>
          <address><strong>ODONTO SPACE</strong><br />{SITE.address.street}<br />{SITE.address.neighborhood} – {SITE.address.city}/{SITE.address.state}</address>
        </div>
        <div class="btn-row" style="margin:0">
          <WhatsAppButton variant="light" context="home-localizacao" label="Falar no WhatsApp" />
          <a class="btn btn--line-light" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Abrir no mapa</a>
        </div>
      </div>
      <Photo class="rv d1" src={sorrisoNatural} alt="Paciente sorrindo, em retrato" pos="50% 30%" illustrative zoom sizes="(max-width: 860px) 100vw, 50vw" />
    </div>
  </section>
</BaseLayout>
