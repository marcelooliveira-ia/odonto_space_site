---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Em from '../components/Em.astro';
import { SITE, SERVICES } from '../config/site';
import { href } from '../utils/url';
import { fotoMarceloSouza, ortodontista } from '../assets';

const o = SITE.generalDentist; const ort = SITE.orthodontist;
const msgGeral = SERVICES.find((s) => s.title === 'Clínica geral')!.whatsappMessage;
---
<BaseLayout title="A Clínica e Equipe | ODONTO SPACE em Bangu" description="Conheça a ODONTO SPACE, clínica odontológica em Bangu, Rio de Janeiro: nossa forma de atender e a equipe responsável pelo seu cuidado." path="/a-clinica-e-equipe" breadcrumb="A clínica e equipe">
  <section class="ht dark fx">
    <span class="arc a" aria-hidden="true"></span><span class="arc b" aria-hidden="true"></span>
    <div class="wrap g12">
      <nav class="crumb label" aria-label="Você está em" style="grid-column:1/-1"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">A clínica e equipe</span></nav>
      <h1 style="grid-column:1/-1"><Em text="Conheça a *ODONTO SPACE*" /></h1>
      <div class="ht__lead">
        <p class="lead">Uma clínica odontológica em Bangu, com atendimento acolhedor e profissional em diferentes especialidades.</p>
        <div class="btn-row" style="margin-top:1.4rem"><WhatsAppButton context="clinica-hero" size="lg" /></div>
      </div>
    </div>
  </section>

  <section class="manif">
    <div class="wrap g12">
      <div class="manif__txt">
        <p class="label rv">Nossa forma de cuidar</p>
        <p class="man" data-man>Cuidar do sorriso vai além da estética. É entender cada caso, planejar o tratamento e buscar saúde, função, harmonia e confiança de forma individualizada.</p>
      </div>
      <ul class="checks rv">
        <li><Icon name="check" size={18} /><span>Avaliação individual antes de qualquer indicação</span></li>
        <li><Icon name="check" size={18} /><span>Explicação das opções e das etapas de cada tratamento</span></li>
        <li><Icon name="check" size={18} /><span>Contato direto com a equipe pelo WhatsApp</span></li>
      </ul>
      <p class="lead rv manif__lead">A ODONTO SPACE atende em Bangu, no Rio de Janeiro, com foco em um atendimento humano e acessível. Nossas áreas de atuação incluem implantes, próteses, ortodontia e Invisalign, estética do sorriso e clínica geral.</p>
    </div>
  </section>

  <section class="team-sec sec--mist" id="equipe">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Equipe</p><h2>Quem cuida do <em>seu sorriso</em></h2></div></div>

      <article class="pro pro--a g12">
        <figure class="pro__img rv">
          <Photo src={fotoMarceloSouza} alt={o.photoAlt} ratio="4 / 5" pos="50% 14%" eager widths={[480, 800, 1000]} sizes="(max-width: 860px) 82vw, 44vw" />
        </figure>
        <div class="pro__txt">
          <p class="label rv">{o.title} · {o.role}</p>
          <h3 class="pro__name rv d1">{o.name}</h3>
          {o.cro && <p class="small rv d1">{o.cro}</p>}
          <p class="lead rv d2">Cirurgião-dentista clínico geral, realiza diversos tipos de procedimentos odontológicos. Se você não sabe por onde começar, a avaliação com o clínico geral ajuda a entender o seu caso e a definir os próximos passos.</p>
          <div class="btn-row rv d3"><WhatsAppButton message={msgGeral} context="clinica-clinico-geral" label="Agendar consulta de clínica geral" /></div>
        </div>
      </article>

      <article class="pro pro--b g12">
        <figure class="pro__img rv">
          <Photo src={ortodontista} alt={ort.photoAlt} ratio="4 / 5" pos="50% 14%" widths={[400, 520, 720]} sizes="(max-width: 860px) 68vw, 30vw" />
        </figure>
        <div class="pro__txt">
          <p class="label rv">Ortodontista · ODONTO SPACE</p>
          <h3 class="pro__name rv d1">{ort.name ?? 'Ortodontia'}</h3>
          {ort.cro && <p class="small rv d1">{ort.cro}</p>}
          <p class="lead rv d2">Responsável pelo atendimento de ortodontia na clínica. Na avaliação, analisa o seu caso e explica as opções de tratamento, com aparelho ortodôntico ou alinhadores Invisalign.</p>
          <div class="btn-row rv d3"><a class="link" href={href('/ortodontia-invisalign')}>Conheça a ortodontia e o Invisalign <Icon name="arrow" size={16} /></a></div>
        </div>
      </article>
      {SITE.technicalResponsible && <p class="small" style="margin-top:2rem">Responsável técnico: {SITE.technicalResponsible.name} – {SITE.technicalResponsible.cro}</p>}
    </div>
  </section>
</BaseLayout>
