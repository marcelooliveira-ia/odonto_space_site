---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { SITE, SERVICES } from '../config/site';
import { href } from '../utils/url';
import { fotoMarceloSouza, ortodontista, genRecepcao, genInstrumentos, genConsultorio, genPacienteIA, genOrtoMaos } from '../assets';

const o = SITE.generalDentist; const ort = SITE.orthodontist;
const msgGeral = SERVICES.find((s) => s.title === 'Clínica geral')!.whatsappMessage;
---
<BaseLayout title="A Clínica e Equipe | ODONTO SPACE em Bangu" description="Conheça a ODONTO SPACE, clínica odontológica em Bangu, Rio de Janeiro: nossa forma de atender e a equipe responsável pelo seu cuidado." path="/a-clinica-e-equipe" breadcrumb="A clínica e equipe">
  <PageHero crumb="A clínica e equipe" label="A clínica" title="Conheça a *ODONTO SPACE*" lead="Uma clínica odontológica em Bangu, com atendimento acolhedor e profissional em diferentes especialidades.">
    <WhatsAppButton slot="actions" context="clinica-hero" size="lg" />
    <Photo slot="media" src={genRecepcao} alt="Recepção clara e acolhedora de clínica odontológica" ratio="4 / 5" pos="30% 50%" eager illustrative sizes="(max-width: 900px) 80vw, 420px" />
  </PageHero>

  <section class="sec">
    <div class="wrap split">
      <div>
        <p class="label rv">Nossa forma de cuidar</p>
        <p class="man" data-man style="font-size:clamp(1.5rem,3vw,2.4rem)">Cuidar do sorriso vai além da estética. É entender cada caso, planejar o tratamento e buscar saúde, função, harmonia e confiança de forma individualizada.</p>
        <p class="lead rv">A ODONTO SPACE atende em Bangu, no Rio de Janeiro, com foco em um atendimento humano e acessível. Nossas áreas de atuação incluem implantes, próteses, ortodontia e Invisalign, estética do sorriso e clínica geral.</p>
        <ul class="checks rv"><li><Icon name="check" size={18} /><span>Avaliação individual antes de qualquer indicação</span></li><li><Icon name="check" size={18} /><span>Explicação das opções e das etapas de cada tratamento</span></li><li><Icon name="check" size={18} /><span>Contato direto com a equipe pelo WhatsApp</span></li></ul>
      </div>
      <Photo class="rv" src={genInstrumentos} alt="Instrumentos odontológicos esterilizados sobre uma bandeja" ratio="4 / 5" pos="50% 50%" illustrative zoom sizes="(max-width: 860px) 100vw, 46vw" />
    </div>
  </section>

  <section class="sec sec--mist team-sec" id="equipe">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Equipe</p><h2>Quem cuida do <em>seu sorriso</em></h2></div></div>

      <article class="pro">
        <figure class="pro__img pro__img--a rv">
          <Photo class="ph--arch" src={fotoMarceloSouza} alt={o.photoAlt} ratio="4 / 5" pos="50% 14%" eager widths={[480, 800, 1000]} sizes="(max-width: 860px) 80vw, 440px" />
        </figure>
        <div class="pro__txt">
          <p class="label rv">{o.title} · {o.role}</p>
          <h3 class="pro__name rv d1">{o.name}</h3>
          {o.cro && <p class="small rv d1">{o.cro}</p>}
          <p class="lead rv d2">Cirurgião-dentista clínico geral, realiza diversos tipos de procedimentos odontológicos. Se você não sabe por onde começar, a avaliação com o clínico geral ajuda a entender o seu caso e a definir os próximos passos.</p>
          <div class="btn-row rv d3"><WhatsAppButton message={msgGeral} context="clinica-clinico-geral" label="Agendar consulta de clínica geral" /></div>
        </div>
      </article>

      <article class="pro pro--rev">
        <figure class="pro__img pro__img--b rv">
          <Photo class="ph--leaf" src={ortodontista} alt={ort.photoAlt} ratio="4 / 5" pos="50% 14%" widths={[400, 520, 800]} sizes="(max-width: 860px) 70vw, 380px" />
        </figure>
        <div class="pro__txt">
          <p class="label rv">Ortodontista · ODONTO SPACE</p>
          <h3 class="pro__name rv d1">{ort.name ?? 'Ortodontia'}</h3>
          {ort.cro && <p class="small rv d1">{ort.cro}</p>}
          <p class="lead rv d2">Responsável pelo atendimento de ortodontia na clínica. Na avaliação, analisa o seu caso e explica as opções de tratamento, com aparelho ortodôntico ou alinhadores Invisalign.</p>
          <div class="btn-row rv d3"><a class="link" href={href('/ortodontia-invisalign')}>Conheça a ortodontia e o Invisalign <Icon name="arrow" size={16} /></a></div>
        </div>
      </article>
      {SITE.technicalResponsible && <p class="small" style="margin-top:2rem">Responsável técnico: {SITE.technicalResponsible.name} – {SITE.technicalResponsible.cro}</p>}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-top"><div class="rv"><p class="label">Atendimento</p><h2>Cuidado em <em>cada etapa</em></h2></div></div>
      <div class="mosaic">
        <Photo class="rv m1" src={genConsultorio} alt="Consultório odontológico claro e moderno" pos="45% 50%" illustrative zoom sizes="(max-width: 860px) 100vw, 58vw" />
        <Photo class="rv d1 m2" src={genPacienteIA} alt="Mulher sorrindo em um consultório moderno (imagem gerada por IA)" pos="50% 30%" illustrative ai zoom sizes="(max-width: 860px) 100vw, 42vw" />
        <Photo class="rv d2 m3" src={genOrtoMaos} alt="Mãos enluvadas encaixando um alinhador transparente em um modelo dentário" pos="50% 50%" illustrative zoom sizes="(max-width: 860px) 100vw, 42vw" />
      </div>
      <p class="small rv" style="margin:1.4rem 0 0;color:var(--mute)">As fotografias reais da recepção, do consultório e da fachada da ODONTO SPACE serão incluídas nesta seção. As imagens acima foram geradas por IA, são ilustrativas e não mostram a clínica nem seus profissionais.</p>
    </div>
  </section>
</BaseLayout>
