---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Em from '../components/Em.astro';
import { SITE, MAPS_URL } from '../config/site';
import { href } from '../utils/url';
import { genConsultorio } from '../assets';
---
<BaseLayout title="Contato e Localização | ODONTO SPACE Bangu" description="Fale com a ODONTO SPACE pelo WhatsApp (21) 99613-9234 e veja como chegar: Rua Francisco Real, 1910, sala 201, Bangu, Rio de Janeiro." path="/contato-e-localizacao" breadcrumb="Contato e localização" includeBusinessSchema hideCta>
  <section class="hk fx">
    <div class="wrap">
      <div class="hk__txt">
        <nav class="crumb label" aria-label="Você está em"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">Contato e localização</span></nav>
        <p class="label">WhatsApp</p>
        <h1><Em text="Fale com a *ODONTO SPACE*" /></h1>
        <a class="bignum" href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener noreferrer" data-wa="contato-numero" aria-label={`WhatsApp ${SITE.whatsapp.display}`}><span class="bignum__ico"><Icon name="whatsapp" size={44} /></span>{SITE.whatsapp.display}</a>
        <p class="lead">Fale direto com a equipe, tire dúvidas e combine o melhor momento para a sua avaliação.</p>
        <div class="btn-row"><WhatsAppButton context="contato-principal" size="lg" label="Chamar no WhatsApp" /><a class="link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="arrow" size={16} /></a></div>
      </div>
    </div>
    <figure class="hk__img"><Photo src={genConsultorio} alt="Consultório odontológico claro e moderno" ratio="auto" pos="92% 50%" eager illustrative widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 30vw" /></figure>
  </section>

  <section class="loc-sec">
    <div class="wrap g12">
      <div class="loc-sec__addr">
        <p class="label rv">Endereço</p>
        <h2 class="rv d1"><Em text="Rua Francisco Real, *1910*" /></h2>
        <address class="rv d2">Sala 201<br />{SITE.address.neighborhood} – {SITE.address.city}/{SITE.address.state}</address>
        <p class="rv d3" style="margin:1.6rem 0 0"><a class="link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Abrir no mapa <Icon name="arrow" size={16} /></a></p>
      </div>
      <dl class="facts-list rv">
        <div><dt>Região atendida</dt><dd>Bangu e bairros próximos da Zona Oeste</dd></div>
        <div><dt>Horários</dt><dd>{SITE.hours ?? 'Consulte os horários de atendimento pelo WhatsApp.'}</dd></div>
        <div><dt>Agendamento</dt><dd>Avaliação marcada pelo WhatsApp</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>
