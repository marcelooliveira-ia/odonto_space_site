---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import { SERVICES } from '../config/site';
import { href } from '../utils/url';
import { genProteseCoroas, genProteseLab } from '../assets';

const msg = SERVICES.find((s) => s.slug === 'proteses-dentarias')!.whatsappMessage;
const types = [
  { title: 'Prótese total', text: 'Substitui todos os dentes de uma arcada, quando não há mais dentes naturais na região.' },
  { title: 'Prótese parcial', text: 'Repõe alguns dentes ausentes, aproveitando os dentes que permanecem na boca.' },
  { title: 'Prótese fixa', text: 'Coroas e pontes fixadas sobre dentes ou estruturas preparadas pelo dentista.' },
  { title: 'Prótese sobre implante', text: 'Prótese apoiada em implantes dentários, conforme a avaliação do caso.' },
];
const faqs = [
  { q: 'Qual prótese é a melhor para mim?', a: 'Depende de quantos dentes faltam, da saúde da gengiva e do osso, das suas necessidades e do seu orçamento. O dentista indica as opções após a avaliação.' },
  { q: 'A prótese precisa de manutenção?', a: 'Sim. Higiene adequada e consultas de revisão ajudam a conservar a prótese e a saúde da boca. O dentista orienta o cuidado para cada tipo.' },
  { q: 'Posso fazer prótese e implante juntos?', a: 'Em muitos casos, a prótese pode ser apoiada em implantes. A viabilidade é definida na avaliação clínica.' },
];
---
<BaseLayout title="Próteses Dentárias em Bangu | ODONTO SPACE" description="Próteses dentárias em Bangu, Rio de Janeiro: totais, parciais, fixas e sobre implante. Avaliação na ODONTO SPACE e agendamento pelo WhatsApp." path="/proteses-dentarias" breadcrumb="Próteses dentárias" whatsappMessage={msg}>
  <div class="wrap pr-crumb"><nav class="crumb label" style="margin:0" aria-label="Você está em"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">Próteses dentárias</span></nav></div>
  <Photo class="pr-pano" src={genProteseCoroas} alt="Coroas e ponte de cerâmica ao lado de um modelo de gesso" ratio="21 / 9" pos="50% 58%" eager n="01" widths={[800, 1200, 1600, 2000]} sizes="100vw" />
  <div class="wrap g12 pr-head">
    <h1 class="pr-title fx-in">Próteses <em>dentárias em Bangu</em></h1>
    <div class="pr-head__side fx-in">
      <p class="label">Prótese dentária</p>
      <p class="lead">Recupere a função mastigatória e a estética do sorriso com uma solução indicada para o seu caso.</p>
      <div class="row" style="margin-top:1rem"><WhatsAppButton message={msg} context="proteses-hero" label="Agendar avaliação de prótese" /></div>
    </div>
  </div>

  <section class="pr-types">
    <div class="wrap g12">
      <div class="pr-types__list">
        <span class="label pr-types__label rv">Tipos de prótese · a escolha é do dentista, após avaliar a sua boca</span>
        {types.map((t, i) => <div class="pr-type rv"><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{t.title}</h3><p>{t.text}</p></div></div>)}
      </div>
      <Photo class="pr-types__img rv d1" src={genProteseLab} alt="Técnico finalizando uma prótese dentária em laboratório" ratio="4 / 5" pos="50% 45%" n="02" sizes="(max-width: 860px) 72vw, 30vw" />
    </div>
  </section>

  <section class="pr-start on-ice">
    <div class="wrap g12">
      <h2 class="rv">Uma avaliação para entender suas opções.</h2>
      <div class="pr-start__side rv d1">
        <ul>
          <li>Exame clínico e conversa sobre suas necessidades</li>
          <li>Alternativas possíveis para o seu caso</li>
          <li>Plano de tratamento explicado antes de iniciar</li>
        </ul>
        <WhatsAppButton message={msg} context="proteses-meio" variant="solid" />
      </div>
    </div>
  </section>

  <section class="pr-faq">
    <div class="wrap">
      <p class="label rv">Dúvidas frequentes</p>
      <h2 class="rv d1">Perguntas sobre próteses.</h2>
      <div class="faq rv">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      <p class="note">Conteúdo informativo. Somente um cirurgião-dentista pode indicar o tratamento adequado após avaliar você.</p>
    </div>
  </section>
</BaseLayout>
