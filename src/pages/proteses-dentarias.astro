---
import BaseLayout from '../layouts/BaseLayout.astro';
import Em from '../components/Em.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../config/site';
import { href } from '../utils/url';
import { genProteseCoroas, genProteseLab } from '../assets';

const msg = SERVICES.find((s) => s.slug === 'proteses-dentarias')!.whatsappMessage;
const types = [
  { title: 'Prótese total', text: 'Substitui todos os dentes de uma arcada, quando não há mais dentes naturais na região.' },
  { title: 'Prótese parcial', text: 'Repõe alguns dentes ausentes, aproveitando os dentes que permanecem na boca.' },
  { title: 'Prótese fixa', text: 'Coroas e pontes fixadas sobre dentes ou estruturas preparadas pelo dentista.' },
  { title: 'Prótese sobre implante', text: 'Prótese apoiada em implantes dentários, conforme a avaliação do caso.' },
];
const faqs = [
  { q: 'Qual prótese é a melhor para mim?', a: 'Depende de quantos dentes faltam, da saúde da gengiva e do osso, das suas necessidades e do seu orçamento. O dentista indica as opções após a avaliação.' },
  { q: 'A prótese precisa de manutenção?', a: 'Sim. Higiene adequada e consultas de revisão ajudam a conservar a prótese e a saúde da boca. O dentista orienta o cuidado para cada tipo.' },
  { q: 'Posso fazer prótese e implante juntos?', a: 'Em muitos casos, a prótese pode ser apoiada em implantes. A viabilidade é definida na avaliação clínica.' },
];
---
<BaseLayout title="Próteses Dentárias em Bangu | ODONTO SPACE" description="Próteses dentárias em Bangu, Rio de Janeiro: totais, parciais, fixas e sobre implante. Avaliação na ODONTO SPACE e agendamento pelo WhatsApp." path="/proteses-dentarias" breadcrumb="Próteses dentárias" whatsappMessage={msg}>
  <section class="hl fx">
    <div class="wrap g12">
      <div class="hl__txt">
        <nav class="crumb label" aria-label="Você está em"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">Próteses dentárias</span></nav>
        <p class="label">Prótese dentária</p>
        <h1><Em text="Próteses *dentárias* em Bangu" /></h1>
        <p class="lead">Recupere a função mastigatória e a estética do sorriso com uma solução indicada para o seu caso.</p>
        <div class="btn-row"><WhatsAppButton message={msg} context="proteses-hero" size="lg" label="Agendar avaliação de prótese" /></div>
      </div>
      <figure class="hl__img"><Photo src={genProteseCoroas} alt="Coroas e ponte de cerâmica ao lado de um modelo de gesso" ratio="16 / 11" pos="50% 58%" eager illustrative widths={[800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 56vw" /></figure>
    </div>
  </section>

  <section class="tipos-sec after-hl">
    <div class="wrap g12">
      <figure class="tipos__img rv"><Photo src={genProteseLab} alt="Técnico finalizando uma prótese dentária em laboratório" ratio="4 / 5" pos="50% 45%" illustrative sizes="(max-width: 860px) 78vw, 40vw" /></figure>
      <div class="tipos__txt">
        <p class="label rv">Tipos de prótese</p>
        <h2 class="rv d1"><Em text="Opções para *diferentes situações*" /></h2>
        <p class="lead rv d2">A escolha do tipo ideal é feita pelo dentista, depois de avaliar a sua boca.</p>
        <div class="spec rv d3" style="margin-top:1.6rem">{types.map((t) => <div class="spec__row"><h3>{t.title}</h3><p>{t.text}</p></div>)}</div>
      </div>
    </div>
  </section>

  <section class="start-sec dark">
    <div class="wrap g12">
      <div style="display:contents">
        <h2 class="rv"><Em text="Uma avaliação para entender *suas opções*" /></h2>
        <div class="start-sec__list rv d1">
          <ul class="checks">
            <li><Icon name="check" size={18} /><span>Exame clínico e conversa sobre suas necessidades</span></li>
            <li><Icon name="check" size={18} /><span>Alternativas possíveis para o seu caso</span></li>
            <li><Icon name="check" size={18} /><span>Plano de tratamento explicado antes de iniciar</span></li>
          </ul>
          <div class="btn-row" style="margin-top:1.6rem"><WhatsAppButton message={msg} context="proteses-meio" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap faqgrid">
      <div><p class="label">Dúvidas frequentes</p><h2>Perguntas sobre <em>próteses</em></h2><p class="notice">Conteúdo informativo. Somente um cirurgião-dentista pode indicar o tratamento adequado após avaliar você.</p></div>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>
</BaseLayout>
