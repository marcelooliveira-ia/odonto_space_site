---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import '../styles/v6.css';
import { MAPS_URL } from '../config/site';
import { whatsappLink, whatsappPlain } from '../utils/whatsapp';
import { href } from '../utils/url';
import { faqSchema } from '../utils/schema';
import { genProteseCoroas, genProteseLab } from '../assets';
---

<BaseLayout
  system="v6"
  title="Próteses Dentárias em Bangu | ODONTO SPACE"
  description="Próteses dentárias em Bangu, Rio de Janeiro: totais, parciais, fixas e sobre implante. Avaliação na ODONTO SPACE e agendamento pelo WhatsApp."
  path="/proteses-dentarias"
  crumbs={[{ name: 'Próteses dentárias', path: '/proteses-dentarias' }]}
  schemas={[faqSchema([
    { q: 'Qual prótese é a melhor para mim?', a: 'Depende de quantos dentes faltam, da saúde da gengiva e do osso, das suas necessidades e do seu orçamento. O dentista indica as opções após a avaliação.' },
    { q: 'A prótese precisa de manutenção?', a: 'Sim. Higiene adequada e consultas de revisão ajudam a conservar a prótese e a saúde da boca. O dentista orienta o cuidado para cada tipo.' },
    { q: 'Posso fazer prótese e implante juntos?', a: 'Em muitos casos, a prótese pode ser apoiada em implantes. A viabilidade é definida na avaliação clínica.' }
  ])]}
>
<div class="wrap pr-crumb">
<nav class="crumb label" style="margin:0" aria-label="Você está em"><a href={href('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">Próteses dentárias</span></nav></div> 
<figure class="fg pr-pano"> <div class="ph" style="--ar:21 / 9"> <Image src={genProteseCoroas} alt="Coroas e ponte de cerâmica ao lado de um modelo de gesso" widths={[800, 1200, 1600, 2000]} sizes="100vw" format="webp" quality={80} loading="eager" decoding="async" style="object-position:50% 58%" /></div>  </figure> 
<div class="wrap g12 pr-head"> <h1 class="pr-title fx-in">Próteses <em>dentárias em Bangu</em></h1> <div class="pr-head__side fx-in"> <p class="label">Prótese dentária</p> <p class="lead">Recupere a função mastigatória e a estética do sorriso com uma solução indicada para o seu caso.</p> <div class="row" style="margin-top:1rem"><a class="wa wa--link wa--md" href={whatsappLink('Olá! Gostaria de informações sobre próteses dentárias na ODONTO SPACE.')} target="_blank" rel="noopener noreferrer" data-wa="proteses-hero"> <Icon name="whatsapp" size={24} /> <span>Agendar avaliação de prótese</span> </a></div> </div> </div> 
<section class="pr-types"> 
<div class="wrap g12"> <div class="pr-types__list"> <span class="label pr-types__label rv">Tipos de prótese · indicação do melhor tratamento</span> <div class="pr-type rv"><span>01</span><div><h3>Prótese total</h3><p>Substitui todos os dentes de uma arcada, quando não há mais dentes naturais na região.</p></div></div><div class="pr-type rv"><span>02</span><div><h3>Prótese parcial</h3><p>Repõe alguns dentes ausentes, aproveitando os dentes que permanecem na boca.</p></div></div><div class="pr-type rv"><span>03</span><div><h3>Prótese fixa</h3><p>Coroas e pontes fixadas sobre dentes ou estruturas preparadas pelo dentista.</p></div></div><div class="pr-type rv"><span>04</span><div><h3>Prótese sobre implante</h3><p>Prótese apoiada em implantes dentários, conforme a avaliação do caso.</p></div></div> </div> 
<figure class="fg pr-types__img rv d1"> <div class="ph" style="--ar:4 / 5"> <Image src={genProteseLab} alt="Técnico finalizando uma prótese dentária em laboratório" widths={[480, 800, 1200]} sizes="(max-width: 860px) 90vw, 40vw" format="webp" quality={80} loading="lazy" decoding="async" style="object-position:50% 45%" /></div>  </figure> </div> </section>
 
<section class="pr-start on-ice"> 
<div class="wrap g12"> <h2 class="rv">Uma avaliação para entender suas opções.</h2> <div class="pr-start__side rv d1"> <ul> <li>Exame clínico e conversa sobre suas necessidades</li> <li>Alternativas possíveis para o seu caso</li> <li>Plano de tratamento explicado antes de iniciar</li> </ul> <a class="wa wa--solid wa--md" href={whatsappLink('Olá! Gostaria de informações sobre próteses dentárias na ODONTO SPACE.')} target="_blank" rel="noopener noreferrer" data-wa="proteses-meio"> <Icon name="whatsapp" size={24} /> <span>Agendar avaliação pelo WhatsApp</span> </a> </div> </div> </section>
 
<section class="pr-faq"> 
<div class="wrap"> <p class="label rv">Dúvidas frequentes</p> <h2 class="rv d1">Perguntas sobre próteses.</h2> <div class="faq rv"><details><summary>Qual prótese é a melhor para mim?</summary><p>Depende de quantos dentes faltam, da saúde da gengiva e do osso, das suas necessidades e do seu orçamento. O dentista indica as opções após a avaliação.</p></details><details><summary>A prótese precisa de manutenção?</summary><p>Sim. Higiene adequada e consultas de revisão ajudam a conservar a prótese e a saúde da boca. O dentista orienta o cuidado para cada tipo.</p></details><details><summary>Posso fazer prótese e implante juntos?</summary><p>Em muitos casos, a prótese pode ser apoiada em implantes. A viabilidade é definida na avaliação clínica.</p></details></div> <p class="note">Conteúdo informativo. Somente um cirurgião-dentista pode indicar o tratamento adequado após avaliar você.</p> </div> </section>
</BaseLayout>
