---
import Icon from './Icon.astro';
import { NAV, SITE } from '../config/site';
import { href } from '../utils/url';
import { whatsappLink } from '../utils/whatsapp';
import { logoPreto } from '../assets';
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const isActive = (p: string) => (p === '/' ? currentPath === '/' : currentPath === p || (p === '/ortodontia' && currentPath === '/invisalign'));
---
<header class="hdr"><div class="wrap hdr__in">
  <a class="brand" href={href('/')} aria-label={`${SITE.name} – página inicial`}><img src={logoPreto.src} alt={SITE.name} width="38" height="48" /></a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu"><Icon name="menu" size={26} /></button>
  <nav id="menu" class="nav" aria-label="Menu principal">
    <ul>{NAV.map((item) => <li><a href={href(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    <a class="btn" href={whatsappLink()} target="_blank" rel="noopener noreferrer" data-wa="cabecalho"><Icon name="whatsapp" size={22} /><span>WhatsApp</span></a>
  </nav>
</div></header>
