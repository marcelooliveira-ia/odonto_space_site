---
import Icon from './Icon.astro';
import ConsentBanner from './ConsentBanner.astro';
import { whatsappLink } from '../utils/whatsapp';

interface Props {
  message?: string;
}
const { message } = Astro.props;
---

<a
  class="wa-float"
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer"
  data-wa="flutuante"
  aria-label="Falar com a ODONTO SPACE no WhatsApp"
>
  <Icon name="whatsapp" size={30} />
</a>

<ConsentBanner />

<script is:inline>
  // Medição de cliques no WhatsApp: só registra se o visitante consentiu (LGPD).
  document.addEventListener('click', function (e) {
    var el = e.target.closest && e.target.closest('[data-wa]');
    if (!el) return;
    var consent = null;
    try { consent = localStorage.getItem('odonto-consent'); } catch (err) {}
    if (consent === 'granted' && window.dataLayer) {
      window.dataLayer.push({ event: 'whatsapp_click', wa_context: el.getAttribute('data-wa'), page_path: location.pathname });
    }
  });
</script>
