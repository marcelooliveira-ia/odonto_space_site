---
// Animações leves ao rolar. Respeita prefers-reduced-motion; sem JS, tudo fica visível.
---
<script is:inline>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = [].slice.call(document.querySelectorAll('.rv,.mk'));
    if (reduce || !('IntersectionObserver' in window)) els.forEach(function (e) { e.classList.add('in'); });
    else {
      var io = new IntersectionObserver(function (es) { es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      els.forEach(function (e) { io.observe(e); });
      setTimeout(function () { els.forEach(function (e) { e.classList.add('in'); }); }, 6000);
    }
    var man = document.querySelector('[data-man]'), sp = [];
    if (man) { man.innerHTML = man.textContent.trim().split(/\s+/).map(function (w) { return '<span>' + w + '</span>'; }).join(' '); sp = [].slice.call(man.children); }
    var stp = document.querySelector('[data-stp]'), steps = stp ? [].slice.call(stp.children) : [];
    var par = [].slice.call(document.querySelectorAll('.par'));
    function upd() {
      var vh = innerHeight;
      if (man) { var r = man.getBoundingClientRect(); var p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.3))); var n = Math.round(p * sp.length); sp.forEach(function (s, i) { s.classList.toggle('on', reduce || i < n); }); }
      if (stp) { var q = stp.getBoundingClientRect(); var pp = Math.min(1, Math.max(0, (vh * 0.8 - q.top) / (q.height + vh * 0.2))); stp.style.setProperty('--p', reduce ? 1 : pp.toFixed(3)); steps.forEach(function (s, i) { s.classList.toggle('on', reduce || pp >= (i + 0.4) / steps.length); }); }
      if (!reduce) par.forEach(function (e) { var b = e.getBoundingClientRect(); var c = (b.top + b.height / 2 - vh / 2) / vh; e.style.setProperty('--py', (c * -(parseFloat(e.dataset.par || '0.05')) * 100).toFixed(1) + 'px'); });
    }
    var tk = false; addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(function () { upd(); tk = false; }); } }, { passive: true }); addEventListener('resize', upd); upd();
  })();
</script>
