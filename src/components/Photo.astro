---
import { Image } from 'astro:assets';
/**
 * Fotografia das páginas do sistema .v6 (Implantes, Próteses, Clínica). Sem legendas técnicas
 * ("Fig. NN · Imagem ilustrativa") — removidas na v15 aprovada.
 * - `bg`: imagem de fundo de uma seção.
 */
interface Props {
  src: ImageMetadata; alt: string; sizes?: string; widths?: number[]; ratio?: string; pos?: string; eager?: boolean; bg?: boolean; class?: string;
}
const { src, alt, sizes = '(max-width: 900px) 100vw, 50vw', widths = [480, 800, 1200, 1600], ratio, pos = '50% 50%', eager = false, bg = false, class: cls } = Astro.props;
const imgProps = { widths: widths.filter((w) => w <= src.width), sizes, format: 'webp' as const, quality: 80, loading: (eager ? 'eager' : 'lazy') as 'eager' | 'lazy', decoding: 'async' as const, style: `object-position:${pos}` };
---
{bg ? (
  <div class:list={['ph', 'ph--bg', cls]}><Image src={src} alt={alt} {...imgProps} /></div>
) : (
  <figure class:list={['fg', cls]}>
    <div class="ph" style={ratio ? `--ar:${ratio}` : undefined}><Image src={src} alt={alt} {...imgProps} /></div>
  </figure>
)}
