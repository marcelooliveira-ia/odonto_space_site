---
import WhatsAppButton from './WhatsAppButton.astro';
interface Props {
  title?: string;
  text?: string;
  message?: string;
  context?: string;
}
const {
  title = 'Agende sua avaliação na ODONTO SPACE',
  text = 'Fale com a nossa equipe pelo WhatsApp e tire suas dúvidas antes de marcar.',
  message,
  context = 'faixa-cta',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <WhatsAppButton message={message} context={context} variant="light" size="lg" />
  </div>
</section>
