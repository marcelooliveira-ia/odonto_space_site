---
interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="page-hero__lead">{lead}</p>
    <slot />
  </div>
</section>
