---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { SITE } from '../config/site';

/** Bloco de contato por WhatsApp: ícone grande, número em destaque e botão de ação. */
interface Props { context: string; message?: string; label?: string; tone?: 'dark' | 'light' }
const { context, message, label = 'Chamar no WhatsApp', tone = 'dark' } = Astro.props;
---
<div class:list={['wa-cta', tone === 'light' && 'wa-cta--light']}>
  <a class="wa-cta__num" href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener noreferrer" data-wa={`${context}-numero`} aria-label={`WhatsApp ${SITE.whatsapp.display}`}>
    <span class="wa-cta__ico"><Icon name="whatsapp" size={36} /></span>
    <span class="wa-cta__txt"><small>WhatsApp</small><b>{SITE.whatsapp.display}</b></span>
  </a>
  <WhatsAppButton context={context} message={message} label={label} size="lg" />
</div>
