---
import Icon from './Icon.astro';
import { whatsappLink } from '../utils/whatsapp';

interface Props {
  message?: string;
  label?: string;
  /** Identifica o contexto do clique para medição (ex.: "implantes-hero"). */
  context?: string;
  /** link: discreto (padrão, texto com sublinhado) · solid: botão na cor da marca. */
  variant?: 'link' | 'solid' | 'light';
  size?: 'sm' | 'md' | 'lg';
}
const { message, label = 'Agendar avaliação pelo WhatsApp', context = 'geral', variant = 'link', size = 'md' } = Astro.props;
const iconSize = size === 'lg' ? 28 : size === 'sm' ? 20 : 24;
---

<a
  class:list={['wa', `wa--${variant}`, `wa--${size}`]}
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer"
  data-wa={context}
>
  <Icon name="whatsapp" size={iconSize} />
  <span>{label}</span>
</a>
