---
import Icon from './Icon.astro';
import { whatsappLink } from '../utils/whatsapp';

interface Props {
  message?: string;
  label?: string;
  /** Identifica o contexto do clique para medição (ex.: "implantes-hero"). */
  context?: string;
  variant?: 'primary' | 'light' | 'ghost';
  size?: 'md' | 'lg';
}
const { message, label = 'Agendar avaliação pelo WhatsApp', context = 'geral', variant = 'primary', size = 'md' } =
  Astro.props;
---

<a
  class:list={['btn', `btn--wa-${variant}`, size === 'lg' && 'btn--lg']}
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer"
  data-wa={context}
>
  <Icon name="whatsapp" size={20} />
  <span>{label}</span>
</a>
