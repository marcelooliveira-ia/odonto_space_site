---
import Icon from './Icon.astro';
import { NAV, SITE, MAPS_URL } from '../config/site';
import { href } from '../utils/url';
import { logoPreto } from '../assets';
const year = new Date().getFullYear();
---
<footer class="end">
  <div class="wrap end__in">
    <a class="end__brand" href={href('/')} aria-label="ODONTO SPACE – página inicial"><img src={logoPreto.src} alt="ODONTO SPACE" width="73" height="92" /></a>
    <nav class="end__nav" aria-label="Rodapé"><ul>{NAV.map((item) => <li><a href={href(item.href)}>{item.label}</a></li>)}</ul></nav>
    <address class="end__addr">
      <span class="label">Endereço</span>
      {SITE.address.street}<br />{SITE.address.neighborhood} – {SITE.address.city}/{SITE.address.state}<br />
      <a class="link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="arrow" size={14} /></a>
    </address>
    <p class="end__wa"><span class="label">WhatsApp</span><a href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener noreferrer" data-wa="rodape-numero">{SITE.whatsapp.display}</a></p>
    <div class="end__legal">
      {SITE.technicalResponsible && <p>Responsável técnico: {SITE.technicalResponsible.name} – {SITE.technicalResponsible.cro}</p>}
      <p>© {year} ODONTO SPACE · {SITE.address.street}, {SITE.address.neighborhood} – {SITE.address.city}/{SITE.address.state}</p>
      <p>As informações deste site têm caráter educativo e não substituem a avaliação de um cirurgião-dentista. Os resultados e a indicação de cada tratamento variam de acordo com cada paciente. As imagens são ilustrativas (geradas por IA) e não mostram a clínica.</p>
    </div>
  </div>
</footer>
