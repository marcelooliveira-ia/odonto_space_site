---
import Icon from './Icon.astro';
import { NAV, SITE, HOURS, MAPS_URL, FOOTER_WHATSAPP_MESSAGE } from '../config/site';
import { href } from '../utils/url';
import { whatsappLink } from '../utils/whatsapp';
import { logoPreto } from '../assets';
const year = new Date().getFullYear();
const a = SITE.address;
---
<footer class="end"><div class="wrap end__in">
  <a class="end__brand" href={href('/')} aria-label={`${SITE.name} – página inicial`}><img src={logoPreto.src} alt={SITE.name} width="73" height="92" /></a>
  <nav aria-label="Rodapé"><ul>{NAV.map((item) => <li><a href={href(item.href)}>{item.label}</a></li>)}</ul></nav>
  <div class="end__addr"><span class="label">Endereço</span>
    <address>{a.street} – {a.complement.replace(/ /g, ' ')}<br />{a.neighborhood}, {a.city} – {a.state}<br />CEP {a.postalCode}</address>
    <div class="end__acts">
      <a class="wa-cta" href={whatsappLink(FOOTER_WHATSAPP_MESSAGE)} target="_blank" rel="noopener noreferrer" data-wa="rodape"><span class="wa-cta__ico" aria-hidden="true"><Icon name="whatsapp" size={24} /></span><span class="wa-cta__txt"><small>Chamar no WhatsApp</small><b>{SITE.whatsapp.display}</b></span><span class="wa-cta__arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={MAPS_URL} target="_blank" rel="noopener noreferrer" data-wa="rodape-mapa"><span>Como chegar</span></a>
    </div>
  </div>
  <div class="end__hours"><span class="label">Horários</span><dl>{HOURS.map((h) => <div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}</dl></div>
  <div class="end__legal">
    {SITE.technicalResponsible && <p>Responsável técnico: {SITE.technicalResponsible.name} – {SITE.technicalResponsible.cro}</p>}
    <p>© {year} {SITE.name} · <a href={href('/politica-de-privacidade')}><span class="pv-long">Política de </span>Privacidade</a></p>
    <p>As informações deste site têm caráter educativo e não substituem a avaliação de um cirurgião-dentista. Os resultados e a indicação de cada tratamento variam de acordo com cada paciente.</p>
    <p class="credit">{SITE.credit.text} <a href={SITE.credit.url} target="_blank" rel="noopener">{SITE.credit.name}</a></p>
  </div>
</div></footer>
