# Copie para .env (local) ou cadastre na Vercel. NUNCA versione o .env real.

# URL final do site, sem barra no fim (usada em canonical, sitemap e dados estruturados)
PUBLIC_SITE_URL=https://odonto-space-site.vercel.app

# Google Tag Manager (ex.: GTM-XXXXXXX). Vazio = nenhum rastreamento e nenhum banner de cookies.
PUBLIC_GTM_ID=
